# Shared secret - Spring Boot must send the same value in the X-API-KEY header
INTERNAL_API_KEY=change-me-internal-key

# LLM (optional). Leave LLM_PROVIDER=none to run fully offline with templates.
# LLM_PROVIDER=openai works with OpenAI, Gemini (OpenAI-compatible endpoint) or Ollama.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# OCR (Windows example paths; leave empty on Linux/Docker)
TESSERACT_CMD=
POPPLER_PATH=
OCR_LANGUAGES=eng
MAX_UPLOAD_MB=10
